<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CordMic" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cm_accent</item>
        <item name="colorOnPrimary">@color/cm_on_accent</item>
        <item name="colorPrimaryContainer">@color/cm_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/cm_on_surface</item>
        <item name="colorSecondaryContainer">@color/cm_accent_soft</item>
        <item name="colorOnSecondaryContainer">@color/cm_on_surface</item>
        <item name="colorError">@color/cm_red</item>
        <item name="android:colorBackground">@color/cm_background</item>
        <item name="colorSurface">@color/cm_surface</item>
        <item name="colorSurfaceContainer">@color/cm_surface</item>
        <item name="colorSurfaceContainerHigh">@color/cm_surface</item>
        <item name="colorSurfaceContainerHighest">@color/cm_surface_muted</item>
        <item name="colorOnSurface">@color/cm_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/cm_on_surface_variant</item>
        <item name="colorOutline">@color/cm_outline</item>
        <item name="colorOutlineVariant">@color/cm_divider</item>
        <item name="android:windowBackground">@color/cm_background</item>
        <!-- Font goes through the type scale, not android:fontFamily on the theme (that would override every
             TextAppearance). -->
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.CordMic.M3.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.CordMic.M3.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.CordMic.M3.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.CordMic.M3.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.CordMic.M3.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.CordMic.M3.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.CordMic.M3.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.CordMic.M3.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.CordMic.M3.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.CordMic.M3.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.CordMic.M3.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.CordMic.M3.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.CordMic.M3.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.CordMic.M3.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.CordMic.M3.LabelSmall</item>
        <item name="textInputStyle">@style/Widget.CordMic.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.CordMic.Card</item>
    </style>

    <style name="Widget.CordMic.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/cm_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.CordMic.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/cm_input_stroke</item>
        <item name="hintTextColor">@color/cm_accent</item>
        <item name="helperTextTextColor">@color/cm_on_surface_variant</item>
    </style>

    <style name="Widget.CordMic.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/cm_input_stroke</item>
        <item name="hintTextColor">@color/cm_accent</item>
        <item name="helperTextTextColor">@color/cm_on_surface_variant</item>
    </style>

    <style name="Widget.CordMic.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.CordMic.HintButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="TextAppearance.CordMic.AppBar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/cm_on_surface</item>
    </style>
    <style name="TextAppearance.CordMic.StateTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:lineSpacingExtra">2sp</item>
        <item name="android:textColor">@color/cm_on_surface</item>
    </style>
    <style name="TextAppearance.CordMic.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:textColor">@color/cm_on_surface_variant</item>
    </style>
    <style name="TextAppearance.CordMic.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/cm_on_surface</item>
    </style>
    <style name="TextAppearance.CordMic.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/cm_on_surface_variant</item>
    </style>
    <style name="TextAppearance.CordMic.StatValue" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/cm_on_surface</item>
    </style>
    <style name="TextAppearance.CordMic.RowValue" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/cm_on_surface</item>
    </style>
    <style name="TextAppearance.CordMic.M3.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
    </style>
    <style name="TextAppearance.CordMic.M3.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
    </style>
    <style name="TextAppearance.CordMic.M3.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
    </style>
    <style name="TextAppearance.CordMic.M3.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="TextAppearance.CordMic.M3.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="TextAppearance.CordMic.M3.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="TextAppearance.CordMic.M3.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="TextAppearance.CordMic.M3.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="TextAppearance.CordMic.M3.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="TextAppearance.CordMic.M3.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
    </style>
    <style name="TextAppearance.CordMic.M3.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
    </style>
    <style name="TextAppearance.CordMic.M3.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_regular</item>
        <item name="fontFamily">@font/plus_jakarta_sans_regular</item>
    </style>
    <style name="TextAppearance.CordMic.M3.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/plus_jakarta_sans_semibold</item>
        <item name="fontFamily">@font/plus_jakarta_sans_semibold</item>
    </style>
    <style name="TextAppearance.CordMic.M3.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
    </style>
    <style name="TextAppearance.CordMic.M3.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/plus_jakarta_sans_medium</item>
        <item name="fontFamily">@font/plus_jakarta_sans_medium</item>
    </style>
</resources>
