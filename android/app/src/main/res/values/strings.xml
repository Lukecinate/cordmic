<resources>
    <string name="app_name" translatable="false">CordMic</string>

    <!-- Status card -->
    <string name="state_idle_title">Ready to start</string>
    <string name="state_idle_msg_tether_on">USB tethering is on. Tap Start to use this phone as your PC microphone.</string>
    <string name="state_idle_msg_tether_off">Connect the USB cable and turn on USB tethering, then tap Start.</string>
    <string name="state_starting_title">Starting</string>
    <string name="state_starting_msg">Opening the microphone.</string>
    <string name="state_waiting_title">Waiting for USB tethering</string>
    <string name="state_waiting_msg">Turn on USB tethering in Settings. CordMic connects as soon as it is on.</string>
    <string name="state_searching_title">Looking for your PC</string>
    <string name="state_searching_msg">Make sure CordMic is running on your PC. If it is not found, enter the PC IP address in Settings below.</string>
    <string name="state_streaming_title">Streaming to your PC</string>
    <string name="state_streaming_msg">Sending to %1$s with %2$s.</string>
    <string name="state_mic_failed_title">Microphone unavailable</string>
    <string name="state_mic_failed_msg">Another app may be using the microphone. Close it, or stop and start again.</string>
    <string name="state_permission_title">Microphone permission needed</string>
    <string name="state_permission_msg">CordMic needs microphone access to send your voice to the PC.</string>
    <string name="action_open_tethering">Open tethering settings</string>
    <string name="action_open_app_settings">Open app settings</string>
    <string name="err_no_settings_app">Open Settings › Connections › Mobile Hotspot and Tethering on your phone.</string>

    <string name="level_label">Input level</string>
    <string name="level_value_db">%1$d dB</string>
    <string name="level_silent">Silent</string>
    <string name="level_cd">Input level %1$s</string>
