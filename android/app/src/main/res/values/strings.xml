    <!-- Primary action -->
    <string name="start">Start</string>
    <string name="stop">Stop</string>
    <string name="start_cd">Start using this phone as the PC microphone</string>
    <string name="stop_cd">Stop streaming the microphone</string>

    <!-- Settings -->
    <string name="settings_title">Settings</string>
    <string name="settings_summary">%1$s · port %2$d · %3$s</string>
    <string name="settings_locked">Stop streaming to change settings.</string>
    <string name="ip_auto">Auto-detect</string>
    <string name="label_pc_ip">PC IP address</string>
    <string name="helper_pc_ip">Leave empty to find your PC automatically.</string>
    <string name="label_port">UDP port</string>
    <string name="helper_port">Must match the port in the PC app (default 50005).</string>
    <string name="label_mic_mode">Microphone mode</string>
    <string name="preset_voice_recognition">Voice recognition (default)</string>
    <string name="preset_unprocessed">Unprocessed</string>
    <string name="preset_voice_communication">Voice communication</string>
    <string name="preset_voice_recognition_help">Minimal processing. Usually the lowest latency.</string>
    <string name="preset_unprocessed_help">Raw microphone signal without filters.</string>
    <string name="preset_voice_communication_help">Noise suppression and echo cancellation. Adds latency.</string>
    <string name="aaudio_option">Low-latency engine (AAudio)</string>
    <string name="aaudio_help">Uses the fast Android audio path. Turn off only if the audio cuts out.</string>
    <string name="nc_option">Noise cancellation</string>
    <string name="nc_help">Light uses the phone suppressor when available (no extra delay). Strong uses a short spectral filter (2.7 ms) that keeps a little natural background and protects whispers and s/f sounds. Pauses between words are lowered by about 6 dB (Light) or 12 dB (Strong).</string>
    <string name="nc_off">Off</string>
    <string name="nc_light">Light (recommended)</string>
    <string name="nc_strong">Strong</string>
    <string name="clarity_option">Voice clarity</string>
    <string name="clarity_help">Cuts rumble and lifts presence so speech is less muddy.</string>
    <string name="autovol_option">Auto volume</string>
    <string name="autovol_help">Aims for about −18 dBFS. Silence is not boosted, so game voice-activation stays quiet.</string>
    <string name="front_focus_option">Front focus</string>
    <string name="front_focus_help">Prefers the mic that faces you. On phones that cannot set this, CordMic keeps the low-latency path and reports it as unsupported.</string>
    <string name="auto_optimize_option">Optimize automatically</string>
    <string name="auto_optimize_help">Chooses a capture path and starting settings for this phone. A value you set yourself is left unchanged.</string>
    <string name="redetect">Re-detect</string>
    <string name="detected_placeholder">Detected: —</string>
    <string name="front_focus_ar_option">Front focus (higher latency)</string>
    <string name="front_focus_ar_help">Uses AudioRecord so the phone can aim at you. Adds a little latency compared with AAudio exclusive.</string>
    <string name="speech_low_warning">Speech is very quiet (below −40 dBFS). Move closer or raise input gain.</string>
    <string name="auto_update_option">Auto update</string>
    <string name="check_for_updates">Check for updates</string>
    <string name="update_checking">Checking for updates…</string>
    <string name="update_current">You have the latest version (%1$s).</string>
    <string name="update_available">Version %1$s is available.</string>
    <string name="update_failed">Update check failed: %1$s</string>
    <string name="update_installing">Installing update…</string>
    <string name="reset_audio">Reset audio settings</string>
    <string name="gain_option">Mic gain</string>
    <string name="gain_value">+%1$d dB</string>
    <string name="gain_help">Default +6 dB. Auto volume does the rest. Peaks stay at or below −1 dBFS.</string>
    <string name="err_port">Enter a port from 1 to 65535.</string>
    <string name="label_pair_code">Pairing code (optional)</string>
    <string name="helper_pair_code">Only needed when the PC app has \"Require a pairing code on the phone\" turned on.</string>
    <string name="err_pair_code">Enter the 6 digits shown in the PC app, or leave it empty.</string>
    <string name="pairing_needed">The PC asks for a pairing code. Enter the 6 digits shown in the PC app, then tap Stop and Start.</string>
    <string name="err_ip">Enter an IPv4 address such as 192.168.42.10, or leave it empty.</string>
    <string name="expand_cd">Show %1$s</string>
    <string name="collapse_cd">Hide %1$s</string>

