<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp">

        <!-- Brand row: CordMic logo tile (28 dp ic_brand) + wordmark -->
        <TextView
            android:id="@+id/brandName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:accessibilityHeading="true"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.CordMic.AppBar"
            app:drawableStartCompat="@drawable/ic_brand" />
    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="600dp">

                <!-- Status: the one thing the screen answers -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/statusCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/stateIcon"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:importantForAccessibility="no"
                                android:padding="10dp"
                                android:src="@drawable/ic_mic"
                                app:tint="@color/cm_on_surface_variant" />

                            <TextView
                                android:id="@+id/stateTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:accessibilityHeading="true"
                                android:accessibilityLiveRegion="polite"
                                android:textAppearance="@style/TextAppearance.CordMic.StateTitle"
                                tools:text="@string/state_idle_title" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/stateMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textAppearance="@style/TextAppearance.CordMic.Body"
                            tools:text="@string/state_idle_msg_tether_on" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hintAction"
                            style="@style/Widget.CordMic.HintButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:visibility="gone"
                            app:icon="@drawable/ic_usb"
                            tools:text="@string/action_open_tethering"
                            tools:visibility="visible" />

                        <!-- Live numbers, only while streaming. All values come from the running service. -->
                        <LinearLayout
                            android:id="@+id/liveBlock"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:importantForAccessibility="no"
                                    android:text="@string/level_label"
                                    android:textAppearance="@style/TextAppearance.CordMic.Caption" />

                                <TextView
                                    android:id="@+id/levelValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:importantForAccessibility="no"
                                    android:textAppearance="@style/TextAppearance.CordMic.RowValue"
                                    tools:text="-18 dB" />
                            </LinearLayout>

                            <dev.cordmic.LevelMeterView
                                android:id="@+id/level"
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:layout_marginTop="8dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/statSentBox"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:focusable="true"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/statSent"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.CordMic.StatValue"
                                        tools:text="12,480" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/stat_sent"
                                        android:textAppearance="@style/TextAppearance.CordMic.Caption" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/statErrorsBox"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:focusable="true"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/statErrors"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.CordMic.StatValue"
                                        tools:text="0" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/stat_errors"
                                        android:textAppearance="@style/TextAppearance.CordMic.Caption" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/statReplyBox"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1.2"
                                    android:focusable="true"
                                    android:orientation="vertical">
                                    <TextView
                                        android:id="@+id/statReply"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextAppearance.CordMic.StatValue"
                                        tools:text="0.4 s ago" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/stat_reply"
                                        android:textAppearance="@style/TextAppearance.CordMic.Caption" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- The one primary action -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toggle"
                    style="@style/Widget.CordMic.PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/start"
                    app:icon="@drawable/ic_mic" />

                <!-- Settings -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/settingsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/settingsHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:accessibilityHeading="true"
                                    android:text="@string/settings_title"
                                    android:textAppearance="@style/TextAppearance.CordMic.SectionTitle" />
                                <TextView
                                    android:id="@+id/settingsSummary"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="@style/TextAppearance.CordMic.Caption"
                                    tools:text="Auto-detect · port 50005 · Voice recognition" />
                            </LinearLayout>

                            <ImageView
                                android:id="@+id/settingsChevron"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_expand_more"
                                app:tint="@color/cm_on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/settingsBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="20dp"
                            android:paddingBottom="20dp">

                            <TextView
                                android:id="@+id/settingsLocked"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="12dp"
                                android:text="@string/settings_locked"
                                android:textAppearance="@style/TextAppearance.CordMic.Caption"
                                android:visibility="gone" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/ipLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/label_pc_ip"
                                app:helperText="@string/helper_pc_ip"
                                app:placeholderText="@string/ip_auto">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/ip"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:digits="0123456789."
                                    android:importantForAutofill="no"
                                    android:inputType="number|numberDecimal"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/portLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:hint="@string/label_port"
                                app:helperText="@string/helper_port">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/port"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:importantForAutofill="no"
                                    android:inputType="number"
                                    android:maxLength="5"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/presetLayout"
                                style="@style/Widget.CordMic.Dropdown"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:hint="@string/label_mic_mode">
                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/preset"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:minHeight="56dp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:id="@+id/aaudioRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:minHeight="64dp"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:layout_weight="1"
                                    android:importantForAccessibility="no"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/aaudio_option"
                                        android:textAppearance="@style/TextAppearance.CordMic.RowValue"
                                        android:textSize="15sp" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/aaudio_help"
                                        android:textAppearance="@style/TextAppearance.CordMic.Caption" />
                                </LinearLayout>
                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/aaudio"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/aaudio_option"
                                    android:minHeight="48dp" />
                            </LinearLayout>


                            <LinearLayout
                                android:id="@+id/frontFocusRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:minHeight="64dp"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:layout_weight="1"
                                    android:importantForAccessibility="no"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/front_focus_option"
                                        android:textAppearance="@style/TextAppearance.CordMic.RowValue"
                                        android:textSize="15sp" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/front_focus_help"
                                        android:textAppearance="@style/TextAppearance.CordMic.Caption" />
                                </LinearLayout>
                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/frontFocus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/front_focus_option"
                                    android:minHeight="48dp" />
                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/ncModeLayout"
                                style="@style/Widget.CordMic.Dropdown"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:hint="@string/nc_option"
                                app:helperText="@string/nc_help">
                                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                                    android:id="@+id/ncMode"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="none"
                                    android:minHeight="56dp" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <LinearLayout
                                android:id="@+id/clarityRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:minHeight="64dp"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:layout_weight="1"
                                    android:importantForAccessibility="no"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/clarity_option"
                                        android:textAppearance="@style/TextAppearance.CordMic.RowValue"
                                        android:textSize="15sp" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/clarity_help"
                                        android:textAppearance="@style/TextAppearance.CordMic.Caption" />
                                </LinearLayout>
                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/voiceClarity"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/clarity_option"
                                    android:minHeight="48dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/autoVolRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:minHeight="64dp"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:layout_weight="1"
                                    android:importantForAccessibility="no"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/autovol_option"
                                        android:textAppearance="@style/TextAppearance.CordMic.RowValue"
                                        android:textSize="15sp" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/autovol_help"
                                        android:textAppearance="@style/TextAppearance.CordMic.Caption" />
                                </LinearLayout>
                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/autoVolume"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/autovol_option"
                                    android:minHeight="48dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/gainLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/gain_option"
                                android:textAppearance="@style/TextAppearance.CordMic.RowValue"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/gainValue"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textAppearance="@style/TextAppearance.CordMic.Caption" />
                            <com.google.android.material.slider.Slider
                                android:id="@+id/gain"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/gain_option"
                                android:stepSize="1"
                                android:value="6"
                                android:valueFrom="0"
                                android:valueTo="24" />
                            <LinearLayout
                                android:id="@+id/autoOptimizeRow"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:minHeight="64dp"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="12dp"
                                    android:layout_weight="1"
                                    android:importantForAccessibility="no"
                                    android:orientation="vertical">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/auto_optimize_option"
                                        android:textAppearance="@style/TextAppearance.CordMic.RowValue"
                                        android:textSize="15sp" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/auto_optimize_help"
                                        android:textAppearance="@style/TextAppearance.CordMic.Caption" />
                                </LinearLayout>
                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/autoOptimize"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:contentDescription="@string/auto_optimize_option"
                                    android:minHeight="48dp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/detectedSummary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textAppearance="@style/TextAppearance.CordMic.Caption"
                                android:text="@string/detected_placeholder" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/redetect"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/redetect" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/resetAudio"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/reset_audio" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Details (diagnostics) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/detailsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/detailsHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="20dp"
                            android:paddingVertical="12dp">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:accessibilityHeading="true"
                                    android:text="@string/details_title"
                                    android:textAppearance="@style/TextAppearance.CordMic.SectionTitle" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/details_summary"
                                    android:textAppearance="@style/TextAppearance.CordMic.Caption" />
                            </LinearLayout>
                            <ImageView
                                android:id="@+id/detailsChevron"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_expand_more"
                                app:tint="@color/cm_on_surface_variant" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/detailsBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="20dp"
                            android:paddingBottom="12dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
